# API Keys for Voice-Enabled RAG Pipeline
# Copy this file to .env and fill in the values

# ElevenLabs API Key (for Speech-to-Text)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Groq API Key (for ultra-fast LLM generation)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (for query & document embeddings)
# We use text-embedding-3-small which is extremely fast and high-quality
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Target language for MSMARCO-XI config:
# Default is 'hin_Devn' (Hindi in Devanagari) or 'asm_Beng' (Assamese), etc.
# Options: hin_Devn, tam_Taml, tel_Telu, ben_Beng, guj_Gujr, mar_Devn, kan_Knda, mal_Mlym, urd_Arab, pan_Guru
TARGET_LANGUAGE=hin_Devn
